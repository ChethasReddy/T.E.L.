# VibeTrace Arena — required environment variables
# Copy to .env.local and fill in real values for live mode.
# Any missing key automatically enables mock-mode fallback (the app never crashes on missing vars).

# Anthropic — used for /api/guardrail (Haiku) and /api/evaluate (Opus)
ANTHROPIC_API_KEY=

# ElevenLabs — Conversational AI Agents SDK
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_COLD=
ELEVENLABS_AGENT_ID_AGREEABLE=

# Force mock mode for all integrations (true = bypass live APIs even if keys are present)
NEXT_PUBLIC_DEMO_MODE=false
